#!/bin/sh
# Start-up script to install the UIO kernel driver.
start ()
{
    echo "Starting uio-devices"
    rmmod uio_pdrv_genirq 2>/dev/null
    modprobe uio_pdrv_genirq of_id="generic-uio"
}

stop ()
{
    echo "Stopping uio-devices"
    rmmod uio_pdrv_genirq 2>/dev/null
}

restart ()
{
	stop
	start
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		restart
		;;
	*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac