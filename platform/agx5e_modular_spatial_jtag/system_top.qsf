set_global_assignment -name TOP_LEVEL_ENTITY system_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 26.3.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "16:15:23  JANUARY 16, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "26.3.0 Pro Edition"
set_global_assignment -name SEARCH_PATH ip
set_global_assignment -name SEARCH_PATH ip/verilog
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name DEVICE A5ED065BB32AE4S
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name SDC_FILE system_top.sdc
set_global_assignment -name SDC_FILE jtag_example.sdc
# ddr_clocks.sdc and ddr_pins.tcl are written by setup_project.py and are empty
# unless the model streams its weights from external memory.
set_global_assignment -name SDC_FILE ddr_clocks.sdc
set_global_assignment -name SYSTEMVERILOG_FILE system_top.sv

set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL
set_global_assignment -name BOARD "Agilex 5 FPGA E-Series 065B Modular Development Kit MK-A5E065BB32AEA"

# Custom IP _hw.tcl files (spatial PD wrapper, timer, etc.).
set_global_assignment -name IP_SEARCH_PATHS "ip/**/*"

# VDS_FILE / VDS_IP_FILE assignments. setup_project.py writes a vds_files.tcl placeholder;
# generate_sof.tcl regenerates it after save_system / generate_system.
source vds_files.tcl

set_location_assignment PIN_BK31 -to clk_sys_100m_p -comment IOBANK_6A
set_instance_assignment -name GLOBAL_SIGNAL GLOBAL_CLOCK -to clk_sys_100m_p -entity system_top
set_instance_assignment -name IO_STANDARD "3.3-V LVCMOS" -to clk_sys_100m_p -entity system_top

source ddr_pins.tcl
