# Timing constraints for the DDR4 banks this build uses.
#
# Generated by setup_project.py, and empty for a design whose weights are
# initialized from MIF files
{% for bank in ddr_banks %}
# 150Mhz reference clock according to schematic https://docs.altera.com/v/u/docs/836174/agilextm-5-fpga-e-series-065b-modular-fpga-development-kit-board-som-board-schematic
# page 14 (2B) and 16 (3B)
create_clock -name {{ '{' }}{{ board[bank.bank].port_prefix }}_refclk_clk{{ '}' }} -period 6.667 [get_ports {{ '{' }}{{ board[bank.bank].port_prefix }}_refclk_clk{{ '}' }}]
{% endfor %}
