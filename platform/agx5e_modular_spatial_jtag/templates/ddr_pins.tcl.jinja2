# Quartus assignments the DDR4 banks in this build need.
#
# Generated by setup_project.py. Sourced by the .qsf file
{% if ddr_banks %}
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
{% for bank in ddr_banks %}
# bank {{ bank.bank }}{{ " (" + bank.port_name + ")" if bank.port_name else " (features)" }} on IO bank {{ board[bank.bank].io_bank }}
source {{ board[bank.bank].pin_file }}
{% endfor %}
{%- endif %}
