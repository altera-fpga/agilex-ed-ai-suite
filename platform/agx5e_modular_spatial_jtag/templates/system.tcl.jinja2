load_package vds

# VDS system for the Agilex 5 spatial JTAG example design.
#
# This file is generated by setup_project.py from the interface of the spatial
# IP PD wrapper, so the stream ports, their bus widths and the Avalon-MM address
# map always match the compiled model
#
# Address map seen by the JTAG master is documented in setup_project.py
#   0x{{ "%08X"|format(timer_base_addr) }}  inference timer, 16 bytes
#   0x{{ "%08X"|format(input_port.dma_csr_addr) }}  mSGDMA csr and descriptor for {{ input_port.name }}
#   0x{{ "%08X"|format(output_port.dma_csr_addr) }}  mSGDMA csr and descriptor for {{ output_port.name }}
{%- for bank in ddr_banks %}
#   0x{{ "%08X"|format(bank.cntl_addr) }}  span extender control for DDR bank {{ bank.bank }}
{%- endfor %}
{%- for bank in ddr_banks %}
#   0x{{ "%08X"|format(bank.jtag_base_addr) }}  {{ bank.window_bytes }} byte window onto DDR bank {{ bank.bank }}, {{ "weights and input/output tensors" if bank.holds_features and bank.port_name else ("input and output tensors" if bank.holds_features else "weights for " + bank.port_name) }}
{%- endfor %}
#

set proj_dir [get_project_directory]

vds::create_system system -force

# -------------------------------------------------------------------------------------
# Instantiate board clock, resets, jtag-to-avalon signals driven by system top and host
# -------------------------------------------------------------------------------------
vds::create_cell -vlnv altera.com:ip:altera_s10_user_rst_clkgate: reset_release_inst
vds::create_cell -vlnv altera.com:ip:altera_in_system_sources_probes: system_source
# This comes from the board clock on pin BK31. Clocks kernel, jtag, and emif
vds::create_cell -properties { parameters:EXPLICIT_CLOCK_RATE {100000000} } -vlnv altera.com:ip:altera_clock_bridge: clock_bridge_0

vds::create_cell -properties { parameters:gui_output_clock_frequency0 {100.0} parameters:gui_output_clock_frequency_ps0 {10000.0} } -vlnv altera.com:ip:altera_iopll: system_clk_iopll
# The kernel clock is the one dla_adjust_pll.tcl retunes after the fitter, so it
# is the only PLL left out of scripting mode.
vds::create_cell -properties { parameters:gui_output_clock_frequency0 { {{ kernel_clk_mhz }} } parameters:gui_output_clock_frequency_ps0 { {{ "%.3f"|format(1e6 / kernel_clk_mhz) }} } parameters:hp_qsys_scripting_mode {false} } -vlnv altera.com:ip:altera_iopll: kernel_clk_iopll
vds::create_cell -properties { parameters:gui_output_clock_frequency0 {200.0} parameters:gui_output_clock_frequency_ps0 {5000.000} } -vlnv altera.com:ip:altera_iopll: emif_clk_iopll

vds::create_cell -properties { parameters:ACTIVE_LOW_RESET {1} } -vlnv altera.com:ip:altera_reset_bridge: global_reset_in
# pll_reset_in feeds both kernel clk and jtag clk. Add SYNCHRONOUS_EDGES to prevent VDS from attemping to
# auto-sync the reset
vds::create_cell -properties { parameters:ACTIVE_LOW_RESET {1} parameters:SYNCHRONOUS_EDGES {none} } -vlnv altera.com:ip:altera_reset_bridge: pll_reset_in

vds::create_cell -vlnv altera.com:ip:altera_jtag_avalon_master: jtag_to_avalon

# ------------------------------------------------------------------
# Spatial IP
# ------------------------------------------------------------------
vds::create_cell -properties { parameters:{{ input_port.name|upper }}_BUS_SIZE { {{ ddr_channel_width }} } parameters:{{ output_port.name|upper }}_BUS_SIZE { {{ ddr_channel_width }} } } -vlnv :ip:{{ module_name }}_pd_wrapper: spatial_ip

# ------------------------------------------------------------------
# Inference timer, sized for the stream ports of this model
# ------------------------------------------------------------------
vds::create_cell -properties { parameters:INPUT_DATA_WIDTH { {{ ddr_channel_width }} } parameters:INPUT_TOTAL_BEATS { {{ input_port.bus_beats }} } parameters:OUTPUT_DATA_WIDTH { {{ ddr_channel_width }} } parameters:OUTPUT_TOTAL_BEATS { {{ output_port.bus_beats }} } } -vlnv :ip:spatial_inference_timer: spatial_inference_timer_0

# ------------------------------------------------------------------
# Ingress and egress are 256-bit mSGDMAs, matching the EMIF beat and
# the spatial IP I/O ports. Subvectors pack contiguously from the LSB
# of each beat; leftover MSBs are padding.
# Brace every parameter value: VDS silently ignores unbraced -properties (Quartus 26.3).
# ------------------------------------------------------------------

# input: {{ input_port.name }}, {{ input_port.packets }} packet(s), {{ input_port.bus_beats }} beats, {{ input_port.tensor_bytes }} bytes, {{ input_port.subvectors_per_beat }} subvector(s) per beat
vds::create_cell -properties { parameters:MODE {1} parameters:DATA_WIDTH { {{ ddr_channel_width }} } parameters:DATA_FIFO_DEPTH {128} parameters:MAX_BYTE { {{ input_port.ddr_region_bytes }} } parameters:FIX_ADDRESS_WIDTH {33} parameters:USE_FIX_ADDRESS_WIDTH {1} parameters:ENHANCED_FEATURES {1} parameters:TRANSFER_TYPE {Full Word Accesses Only} } -vlnv altera.com:ip:altera_msgdma: ingress_msgdma
vds::create_cell -properties { parameters:SYMBOLS_PER_BEAT { {{ ddr_channel_width // 8 }} } parameters:FIFO_DEPTH {64} } -vlnv altera.com:ip:st_dc_fifo: input_cdc_fifo

# output: {{ output_port.name }}, {{ output_port.packets }} packet(s), {{ output_port.bus_beats }} beats, {{ output_port.tensor_bytes }} bytes, {{ output_port.subvectors_per_beat }} subvector(s) per beat
vds::create_cell -properties { parameters:MODE {2} parameters:DATA_WIDTH { {{ ddr_channel_width }} } parameters:DATA_FIFO_DEPTH {32} parameters:MAX_BYTE { {{ output_port.ddr_region_bytes }} } parameters:FIX_ADDRESS_WIDTH {33} parameters:USE_FIX_ADDRESS_WIDTH {1} parameters:ENHANCED_FEATURES {1} parameters:TRANSFER_TYPE {Full Word Accesses Only} } -vlnv altera.com:ip:altera_msgdma: egress_msgdma
vds::create_cell -properties { parameters:SYMBOLS_PER_BEAT { {{ ddr_channel_width // 8 }} } parameters:FIFO_DEPTH {64} } -vlnv altera.com:ip:st_dc_fifo: output_cdc_fifo

# ------------------------------------------------------------------
# EMIF bank(s)
# ------------------------------------------------------------------
{%- for bank in ddr_banks %}

# bank {{ bank.bank }} on IO bank {{ board[bank.bank].io_bank }}, holding {{ "weights and the input and output tensors" if bank.holds_features and bank.port_name else ("the input and output tensors" if bank.holds_features else "weights for " ~ bank.port_name) }}
{%- if bank.bank == 0 %}
vds::create_cell -properties { parameters:ADV_CAL_ENABLE_REQ {false} parameters:ADV_CAL_ENABLE_WEQ {false} parameters:CTRL_DM_EN {true} parameters:CTRL_ECC_AUTOCORRECT_EN {false} parameters:CTRL_ECC_WRITEBACK_EN {false} parameters:EX_DESIGN_USER_PLL_OUTPUT_FREQ_MHZ {110.0} parameters:MEM_CHANNEL_DATA_DQ_WIDTH {32} parameters:MEM_CHANNEL_ECC_DQ_WIDTH {0} parameters:MEM_CL_CYC {12.0} parameters:MEM_CWL_CYC {11.0} parameters:MEM_DIE_DENSITY_GBITS {16} parameters:MEM_DIE_DQ_WIDTH {8} parameters:MEM_DQ_VREF {35} parameters:MEM_FINE_GRANULARITY_REFRESH_MODE {1.0} parameters:MEM_ODT_DQ_X_IDLE {off} parameters:MEM_ODT_DQ_X_NON_TGT_RD {off} parameters:MEM_ODT_DQ_X_NON_TGT_WR {off} parameters:MEM_ODT_DQ_X_RON {7} parameters:MEM_ODT_DQ_X_TGT_WR {4} parameters:MEM_ODT_NOM {off} parameters:MEM_ODT_PARK {4} parameters:MEM_ODT_WR {off} parameters:MEM_OPERATING_FREQ_MHZ {800} parameters:MEM_OPERATING_FREQ_MHZ_AUTOSET_EN {false} parameters:MEM_PAGE_SIZE {1024.0} parameters:MEM_RD_PREAMBLE_MODE {1.0} parameters:MEM_SPEEDBIN {3200AA} parameters:MEM_TCCD_L_NS {6.25} parameters:MEM_TCCD_S_NS {5.0} parameters:MEM_TCKESR_CYC {5.0} parameters:MEM_TCKE_NS {5.0} parameters:MEM_TCKSRE_NS {10.0} parameters:MEM_TCKSRX_NS {10.0} parameters:MEM_TCK_CL_CWL_MAX_NS {1.5} parameters:MEM_TCK_CL_CWL_MIN_NS {1.25} parameters:MEM_TCPDED_NS {5.0} parameters:MEM_TDQSCK_MAX_MIN_NS {0.16} parameters:MEM_TFAW_NS {25.0} parameters:MEM_TMOD_NS {30.0} parameters:MEM_TMPRR_NS {1.25} parameters:MEM_TMRD_NS {10.0} parameters:MEM_TRAS_MAX_NS {70200.0} parameters:MEM_TRAS_MIN_NS {32.0} parameters:MEM_TRAS_NS {32.0} parameters:MEM_TRCD_NS {13.75} parameters:MEM_TRC_NS {45.75} parameters:MEM_TREFI_NS {7800.0} parameters:MEM_TRFC_NS {350.0} parameters:MEM_TRP_NS {13.75} parameters:MEM_TRRD_L_NS {5.0} parameters:MEM_TRRD_S_NS {5.0} parameters:MEM_TRTP_NS {7.5} parameters:MEM_TWR_CRC_DM_NS {6.25} parameters:MEM_TWR_NS {15.0} parameters:MEM_TWTR_L_CRC_DM_NS {6.25} parameters:MEM_TWTR_L_NS {7.5} parameters:MEM_TWTR_S_CRC_DM_NS {6.25} parameters:MEM_TWTR_S_NS {2.5} parameters:MEM_TXP_NS {6.0} parameters:MEM_TXS_DLL_NS {1280.0} parameters:MEM_TXS_NS {360.0} parameters:MEM_TZQCS_NS {160.0} parameters:MEM_TZQINIT_CYC {1024.0} parameters:MEM_TZQOPER_CYC {512.0} parameters:MEM_VREF_DQ_X_VALUE {67.75} parameters:MEM_WR_PREAMBLE_MODE {1.0} parameters:PHY_AC_PLACEMENT {BOT} parameters:PHY_ALERT_N_PLACEMENT {AC2} parameters:PHY_AC_TX_EQUALIZATION {OFF} parameters:PHY_CK_TX_EQUALIZATION {OFF} parameters:PHY_CS_TX_EQUALIZATION {OFF} parameters:PHY_DQ_TX_EQUALIZATION {OFF} parameters:PHY_MAINBAND_ACCESS_MODE {ASYNC} parameters:PHY_MAINBAND_ACCESS_MODE_AUTOSET_EN {false} parameters:PHY_REFCLK_ADVANCED_SELECT_EN {false} parameters:PHY_REFCLK_FREQ_MHZ {150.0} parameters:PHY_REFCLK_FREQ_MHZ_AUTOSET_EN {false} parameters:PHY_SIDEBAND_ACCESS_MODE {FABRIC} parameters:PHY_SWIZZLE_MAP {BYTE_SWIZZLE_CH0=1,X,X,X,0,2,3,X;  PIN_SWIZZLE_CH0_DQS0=7,5,1,3,4,2,0,6;  PIN_SWIZZLE_CH0_DQS1=9,15,13,11,14,12,8,10;  PIN_SWIZZLE_CH0_DQS2=19,23,21,17,16,18,20,22;  PIN_SWIZZLE_CH0_DQS3=31,29,27,25,26,30,24,28; } parameters:PHY_TERM_X_AC_OUTPUT_IO_STD_TYPE {SSTL} parameters:PHY_TERM_X_AC_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_CK_OUTPUT_IO_STD_TYPE {DF_SSTL} parameters:PHY_TERM_X_CK_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_CS_OUTPUT_IO_STD_TYPE {SSTL} parameters:PHY_TERM_X_CS_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_DQS_IO_STD_TYPE {DF_POD} parameters:PHY_TERM_X_DQ_IO_STD_TYPE {POD} parameters:PHY_TERM_X_DQ_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_DQ_VREF {68.3} parameters:PHY_TERM_X_GPIO_IO_STD_TYPE {LVCMOS} parameters:PHY_TERM_X_REFCLK_IO_STD_TYPE {TRUE_DIFF} parameters:PHY_TERM_X_R_S_AC_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_S_CK_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_S_CS_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_S_DQ_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_T_DQ_INPUT_OHM {RT_50_OHM_CAL} parameters:PHY_TERM_X_R_T_GPIO_INPUT_OHM {RT_OFF} parameters:PHY_TERM_X_R_T_REFCLK_INPUT_OHM {RT_DIFF} } -vlnv altera.com:ip:emif_io96b_ddr4comp: emif_bank0
{%- else %}
vds::create_cell -properties { parameters:ADV_CAL_ENABLE_REQ {false} parameters:ADV_CAL_ENABLE_WEQ {false} parameters:CTRL_DM_EN {true} parameters:CTRL_ECC_AUTOCORRECT_EN {true} parameters:CTRL_ECC_WRITEBACK_EN {true} parameters:EX_DESIGN_USER_PLL_OUTPUT_FREQ_MHZ {110.0} parameters:MEM_CHANNEL_DATA_DQ_WIDTH {32} parameters:MEM_CHANNEL_ECC_DQ_WIDTH {8} parameters:MEM_CL_CYC {12.0} parameters:MEM_CWL_CYC {11.0} parameters:MEM_DIE_DENSITY_GBITS {16} parameters:MEM_DIE_DQ_WIDTH {8} parameters:MEM_DQ_VREF {35} parameters:MEM_FINE_GRANULARITY_REFRESH_MODE {1.0} parameters:MEM_ODT_DQ_X_IDLE {off} parameters:MEM_ODT_DQ_X_NON_TGT_RD {off} parameters:MEM_ODT_DQ_X_NON_TGT_WR {off} parameters:MEM_ODT_DQ_X_RON {7} parameters:MEM_ODT_DQ_X_TGT_WR {4} parameters:MEM_ODT_NOM {off} parameters:MEM_ODT_PARK {4} parameters:MEM_ODT_WR {off} parameters:MEM_OPERATING_FREQ_MHZ {800} parameters:MEM_OPERATING_FREQ_MHZ_AUTOSET_EN {false} parameters:MEM_PAGE_SIZE {1024.0} parameters:MEM_RD_PREAMBLE_MODE {1.0} parameters:MEM_SPEEDBIN {3200AA} parameters:MEM_TCCD_L_NS {6.25} parameters:MEM_TCCD_S_NS {5.0} parameters:MEM_TCKESR_CYC {5.0} parameters:MEM_TCKE_NS {5.0} parameters:MEM_TCKSRE_NS {10.0} parameters:MEM_TCKSRX_NS {10.0} parameters:MEM_TCK_CL_CWL_MAX_NS {1.5} parameters:MEM_TCK_CL_CWL_MIN_NS {1.25} parameters:MEM_TCPDED_NS {5.0} parameters:MEM_TDQSCK_MAX_MIN_NS {0.16} parameters:MEM_TFAW_NS {25.0} parameters:MEM_TMOD_NS {30.0} parameters:MEM_TMPRR_NS {1.25} parameters:MEM_TMRD_NS {10.0} parameters:MEM_TRAS_MAX_NS {70200.0} parameters:MEM_TRAS_MIN_NS {32.0} parameters:MEM_TRAS_NS {32.0} parameters:MEM_TRCD_NS {13.75} parameters:MEM_TRC_NS {45.75} parameters:MEM_TREFI_NS {7800.0} parameters:MEM_TRFC_NS {350.0} parameters:MEM_TRP_NS {13.75} parameters:MEM_TRRD_L_NS {5.0} parameters:MEM_TRRD_S_NS {5.0} parameters:MEM_TRTP_NS {7.5} parameters:MEM_TWR_CRC_DM_NS {6.25} parameters:MEM_TWR_NS {15.0} parameters:MEM_TWTR_L_CRC_DM_NS {6.25} parameters:MEM_TWTR_L_NS {7.5} parameters:MEM_TWTR_S_CRC_DM_NS {6.25} parameters:MEM_TWTR_S_NS {2.5} parameters:MEM_TXP_NS {6.0} parameters:MEM_TXS_DLL_NS {1280.0} parameters:MEM_TXS_NS {360.0} parameters:MEM_TZQCS_NS {160.0} parameters:MEM_TZQINIT_CYC {1024.0} parameters:MEM_TZQOPER_CYC {512.0} parameters:MEM_VREF_DQ_X_VALUE {67.75} parameters:MEM_WR_PREAMBLE_MODE {1.0} parameters:PHY_AC_PLACEMENT {BOT} parameters:PHY_ALERT_N_PLACEMENT {AC2} parameters:PHY_AC_TX_EQUALIZATION {OFF} parameters:PHY_CK_TX_EQUALIZATION {OFF} parameters:PHY_CS_TX_EQUALIZATION {OFF} parameters:PHY_DQ_TX_EQUALIZATION {OFF} parameters:PHY_MAINBAND_ACCESS_MODE {ASYNC} parameters:PHY_MAINBAND_ACCESS_MODE_AUTOSET_EN {false} parameters:PHY_REFCLK_ADVANCED_SELECT_EN {true} parameters:PHY_REFCLK_FREQ_MHZ {150.0} parameters:PHY_REFCLK_FREQ_MHZ_AUTOSET_EN {false} parameters:PHY_SIDEBAND_ACCESS_MODE {FABRIC} parameters:PHY_SWIZZLE_MAP {BYTE_SWIZZLE_CH0=0,X,X,X,1,2,3,ECC; PIN_SWIZZLE_CH0_ECC=0,2,6,4,1,3,7,5; PIN_SWIZZLE_CH0_DQS3=24,25,26,27,28,29,30,31; PIN_SWIZZLE_CH0_DQS2=16,17,18,19,20,21,22,23; PIN_SWIZZLE_CH0_DQS1=12,14,13,10,8,11,15,9; PIN_SWIZZLE_CH0_DQS0=2,0,6,4,7,3,5,1; } parameters:PHY_TERM_X_AC_OUTPUT_IO_STD_TYPE {SSTL} parameters:PHY_TERM_X_AC_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_CK_OUTPUT_IO_STD_TYPE {DF_SSTL} parameters:PHY_TERM_X_CK_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_CS_OUTPUT_IO_STD_TYPE {SSTL} parameters:PHY_TERM_X_CS_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_DQS_IO_STD_TYPE {DF_POD} parameters:PHY_TERM_X_DQ_IO_STD_TYPE {POD} parameters:PHY_TERM_X_DQ_SLEW_RATE {FASTEST} parameters:PHY_TERM_X_DQ_VREF {68.3} parameters:PHY_TERM_X_GPIO_IO_STD_TYPE {LVCMOS} parameters:PHY_TERM_X_REFCLK_IO_STD_TYPE {TRUE_DIFF} parameters:PHY_TERM_X_R_S_AC_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_S_CK_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_S_CS_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_S_DQ_OUTPUT_OHM {SERIES_34_OHM_CAL} parameters:PHY_TERM_X_R_T_DQ_INPUT_OHM {RT_50_OHM_CAL} parameters:PHY_TERM_X_R_T_GPIO_INPUT_OHM {RT_OFF} parameters:PHY_TERM_X_R_T_REFCLK_INPUT_OHM {RT_DIFF} } -vlnv altera.com:ip:emif_io96b_ddr4comp: emif_bank1
{%- endif %}
vds::create_cell -properties { parameters:AXIL_DRIVER_ADDRESS_WIDTH {32} } -vlnv :ip:emif_ph2_axil_driver: emif_bank{{ bank.bank }}_cal
# 33-bit EMIF address, 1GB host window as Avalon word addresses (1GB / 4 = 28 bits)
vds::create_cell -properties { parameters:ENABLE_SLAVE_PORT {1} parameters:MASTER_ADDRESS_WIDTH {33} parameters:SLAVE_ADDRESS_WIDTH {28} } -vlnv altera.com:ip:altera_address_span_extender: emif_bank{{ bank.bank }}_window
{%- endfor %}

# Holds the IP in reset until the design reset releases and every DDR bank has
# finished calibrating. One input for the design reset plus one per bank.
vds::create_cell -properties { parameters:NUM_RESET_INPUTS { {{ ddr_banks|length + 1 }} } parameters:SYNC_DEPTH {16} } -vlnv altera.com:ip:altera_reset_controller: ip_reset_gen

# ------------------------------------------------------------------
# Wire Clocks
# ------------------------------------------------------------------
vds::connect_net -src clock_bridge_0|out_clk -dest global_reset_in|clk
vds::connect_net -src clock_bridge_0|out_clk -dest kernel_clk_iopll|refclk
vds::connect_net -src clock_bridge_0|out_clk -dest system_clk_iopll|refclk
vds::connect_net -src clock_bridge_0|out_clk -dest emif_clk_iopll|refclk
vds::connect_net -src system_clk_iopll|outclk0 -dest jtag_to_avalon|clk
vds::connect_net -src kernel_clk_iopll|outclk0 -dest spatial_ip|clock
vds::connect_net -src kernel_clk_iopll|outclk0 -dest spatial_inference_timer_0|clock
vds::connect_net -src system_clk_iopll|outclk0 -dest ingress_msgdma|clock
vds::connect_net -src system_clk_iopll|outclk0 -dest input_cdc_fifo|in_clk
vds::connect_net -src kernel_clk_iopll|outclk0 -dest input_cdc_fifo|out_clk
vds::connect_net -src system_clk_iopll|outclk0 -dest egress_msgdma|clock
vds::connect_net -src kernel_clk_iopll|outclk0 -dest output_cdc_fifo|in_clk
vds::connect_net -src system_clk_iopll|outclk0 -dest output_cdc_fifo|out_clk

# ------------------------------------------------------------------
# Wire Resets
# ------------------------------------------------------------------
vds::connect_net -src global_reset_in|out_reset -dest kernel_clk_iopll|reset
vds::connect_net -src global_reset_in|out_reset -dest system_clk_iopll|reset
vds::connect_net -src pll_reset_in|out_reset -dest jtag_to_avalon|clk_reset
vds::connect_net -src global_reset_in|out_reset -dest emif_clk_iopll|reset
# The IP waits for the design reset and for every bank to calibrate
vds::connect_net -src ip_reset_gen|reset_out -dest spatial_ip|reset
vds::connect_net -src ip_reset_gen|reset_out -dest spatial_inference_timer_0|reset
vds::connect_net -src pll_reset_in|out_reset -dest ingress_msgdma|reset_n
vds::connect_net -src pll_reset_in|out_reset -dest input_cdc_fifo|in_clk_reset
vds::connect_net -src pll_reset_in|out_reset -dest input_cdc_fifo|out_clk_reset
vds::connect_net -src pll_reset_in|out_reset -dest egress_msgdma|reset_n
vds::connect_net -src pll_reset_in|out_reset -dest output_cdc_fifo|in_clk_reset
vds::connect_net -src pll_reset_in|out_reset -dest output_cdc_fifo|out_clk_reset

# ------------------------------------------------------------------
# Stream data path (ingress and egress)
# ------------------------------------------------------------------
vds::connect_interface_net -src ingress_msgdma|st_source -dest input_cdc_fifo|in
vds::connect_interface_net -src input_cdc_fifo|out -dest spatial_inference_timer_0|input_sink
vds::connect_interface_net -src spatial_inference_timer_0|input_source -dest spatial_ip|{{ input_port.name }}
vds::connect_interface_net -src spatial_ip|{{ output_port.name }} -dest spatial_inference_timer_0|output_sink
vds::connect_interface_net -src spatial_inference_timer_0|output_source -dest output_cdc_fifo|in
vds::connect_interface_net -src output_cdc_fifo|out -dest egress_msgdma|st_sink

vds::connect_interface_net -src ingress_msgdma|mm_read -dest emif_bank{{ feature_bank }}|s0_axi4
vds::assign_base_address -connection ingress_msgdma.mm_read/emif_bank{{ feature_bank }}.s0_axi4 0x00000000
vds::connect_interface_net -src egress_msgdma|mm_write -dest emif_bank{{ feature_bank }}|s0_axi4
vds::assign_base_address -connection egress_msgdma.mm_write/emif_bank{{ feature_bank }}.s0_axi4 0x00000000

# ------------------------------------------------------------------
# Host address map
# ------------------------------------------------------------------
vds::connect_interface_net -src jtag_to_avalon|master -dest spatial_inference_timer_0|avalon_slave
vds::assign_base_address -connection jtag_to_avalon.master/spatial_inference_timer_0.avalon_slave 0x{{ "%08X"|format(timer_base_addr) }}
vds::connect_interface_net -src jtag_to_avalon|master -dest ingress_msgdma|csr
vds::assign_base_address -connection jtag_to_avalon.master/ingress_msgdma.csr 0x{{ "%08X"|format(input_port.dma_csr_addr) }}
vds::connect_interface_net -src jtag_to_avalon|master -dest ingress_msgdma|descriptor_slave
vds::assign_base_address -connection jtag_to_avalon.master/ingress_msgdma.descriptor_slave 0x{{ "%08X"|format(input_port.dma_descriptor_addr) }}
vds::connect_interface_net -src jtag_to_avalon|master -dest egress_msgdma|csr
vds::assign_base_address -connection jtag_to_avalon.master/egress_msgdma.csr 0x{{ "%08X"|format(output_port.dma_csr_addr) }}
vds::connect_interface_net -src jtag_to_avalon|master -dest egress_msgdma|descriptor_slave
vds::assign_base_address -connection jtag_to_avalon.master/egress_msgdma.descriptor_slave 0x{{ "%08X"|format(output_port.dma_descriptor_addr) }}

# ------------------------------------------------------------------
# DDR banks
# ------------------------------------------------------------------
vds::connect_net -src pll_reset_in|out_reset -dest ip_reset_gen|reset_in0
vds::connect_net -src kernel_clk_iopll|outclk0 -dest ip_reset_gen|clk
{%- for bank in ddr_banks %}

# bank {{ bank.bank }}, IO bank {{ board[bank.bank].io_bank }}
vds::connect_net -src emif_clk_iopll|outclk0 -dest emif_bank{{ bank.bank }}|s0_axi4_clock_in
vds::connect_net -src system_clk_iopll|outclk0 -dest emif_bank{{ bank.bank }}|s0_axi4lite_clock
vds::connect_net -src system_clk_iopll|outclk0 -dest emif_bank{{ bank.bank }}_cal|axil_driver_clk
vds::connect_net -src system_clk_iopll|outclk0 -dest emif_bank{{ bank.bank }}_window|clock
vds::connect_net -src pll_reset_in|out_reset -dest emif_bank{{ bank.bank }}|core_init_n
vds::connect_net -src pll_reset_in|out_reset -dest emif_bank{{ bank.bank }}|s0_axi4lite_reset_n
vds::connect_net -src pll_reset_in|out_reset -dest emif_bank{{ bank.bank }}_cal|axil_driver_rst_n
vds::connect_interface_net -src emif_bank{{ bank.bank }}_cal|axil_driver_axi4_lite -dest emif_bank{{ bank.bank }}|s0_axi4lite
vds::assign_base_address -connection emif_bank{{ bank.bank }}_cal.axil_driver_axi4_lite/emif_bank{{ bank.bank }}.s0_axi4lite 0x00000000
# Keep the host out of the bank until it has calibrated
vds::connect_net -src emif_bank{{ bank.bank }}_cal|cal_done_rst_n -dest emif_bank{{ bank.bank }}_window|reset
vds::connect_net -src emif_bank{{ bank.bank }}_cal|cal_done_rst_n -dest ip_reset_gen|reset_in{{ loop.index }}
{%- if bank.port_name %}
# The weight master reads this bank from byte 0, where the compiler put it
vds::connect_interface_net -src spatial_ip|{{ bank.port_name }} -dest emif_bank{{ bank.bank }}|s0_axi4
vds::assign_base_address -connection spatial_ip.{{ bank.port_name }}/emif_bank{{ bank.bank }}.s0_axi4 0x00000000
{%- endif %}
vds::connect_interface_net -src jtag_to_avalon|master -dest emif_bank{{ bank.bank }}_window|windowed_slave
vds::assign_base_address -connection jtag_to_avalon.master/emif_bank{{ bank.bank }}_window.windowed_slave 0x{{ "%08X"|format(bank.jtag_base_addr) }}
vds::connect_interface_net -src jtag_to_avalon|master -dest emif_bank{{ bank.bank }}_window|cntl
vds::assign_base_address -connection jtag_to_avalon.master/emif_bank{{ bank.bank }}_window.cntl 0x{{ "%08X"|format(bank.cntl_addr) }}
vds::connect_interface_net -src emif_bank{{ bank.bank }}_window|expanded_master -dest emif_bank{{ bank.bank }}|s0_axi4
vds::assign_base_address -connection emif_bank{{ bank.bank }}_window.expanded_master/emif_bank{{ bank.bank }}.s0_axi4 0x00000000
{%- endfor %}

# ------------------------------------------------------------------
# Export pins to signals in system top
# ------------------------------------------------------------------
vds::export_pin clock_bridge_0|in_clk ref_clk
vds::export_pin global_reset_in|in_reset resetn
vds::export_pin kernel_clk_iopll|locked kernel_clk_iopll_locked
vds::export_pin pll_reset_in|in_reset pll_resetn_in
vds::export_pin reset_release_inst|ninit_done ninit_done
vds::export_pin system_source|sources sources
# mem_0 goes out under the bare prefix to give ddr4_Nx_mem_dq and friends.
{%- for bank in ddr_banks %}
vds::export_interface_pin emif_bank{{ bank.bank }}|mem_0 {{ board[bank.bank].port_prefix }}
vds::export_interface_pin emif_bank{{ bank.bank }}|mem_ck_0 {{ board[bank.bank].port_prefix }}_ck
vds::export_pin emif_bank{{ bank.bank }}|mem_reset_n {{ board[bank.bank].port_prefix }}_rst
vds::export_pin emif_bank{{ bank.bank }}|oct_0 {{ board[bank.bank].port_prefix }}_oct
vds::export_pin emif_bank{{ bank.bank }}|ref_clk {{ board[bank.bank].port_prefix }}_refclk
{%- endfor %}

vds::validate_system
vds::save_system system

post_message "Script completed successfully."
