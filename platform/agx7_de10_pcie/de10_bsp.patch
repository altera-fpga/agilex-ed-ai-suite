+                .clock            (clock),
+                .resetn           (resetn),
+
+                //upstream interface
+                .i_valid          (i_valid_dups[z]),
+                .i_data           (i_data[z*get_slice_width(MAX_SLICE_WIDTH) +: SLICE_WIDTH_LOCAL]),
