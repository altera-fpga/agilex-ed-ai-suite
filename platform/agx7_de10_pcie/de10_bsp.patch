+  post_message "Attempting to apply fix to $q"
+  substFile "name=\"force_hrc\" value=\"0\"" "name=\"force_hrc\" value=\"1\"" $q $q.am_tmp
+  file copy -force $q.am_tmp $q
+  file delete -force $q.am_tmp
+}
