+            .THRESHOLD                  (3),
+            .INITIAL_OCCUPANCY          (INITIAL_OCCUPANCY),
+            .THRESHOLD_REACHED_AT_RESET (0),
+            .WRITE_AND_READ_DURING_FULL (WRITE_AND_READ_DURING_FULL),
+            .ASYNC_RESET                (ASYNC_RESET),
+            .SYNCHRONIZE_RESET          (0),
+            .RESET_EVERYTHING           (RESET_EVERYTHING),
+            .RESET_EXTERNALLY_HELD      (1)
