+                advance_write_addr <= 1'b0;
+                write_into_fifo <= 1'b0;
+            end
+            else begin
+                ram_wr_en <= ram_wr_en_E;
+                advance_write_addr <= advance_write_addr_E;
+                write_into_fifo <= write_into_fifo_E;
