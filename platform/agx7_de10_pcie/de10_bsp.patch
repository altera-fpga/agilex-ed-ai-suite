+      assign reserved_in_eq           = 32'h0;
+      assign hip_dprio_clk            = 1'b0;
+      assign hip_dprio_reset_n        = 1'b0;
+      assign hip_dprio_ser_shift_load = 1'b0;
+      assign hip_dprio_interface_sel  = 1'b0;
