+    
+    set ADDRESS_UNITS_VALUE               [ get_parameter $ADDRESS_UNITS ]
+
+ 
+    # Interface Names
+    #---------------------------------------------------------------------
+    set CLOCK_INTERFACE  "clock"
+    set RESET_INTERFACE  "reset"
+    set AGENT_INTERFACE  "s0"
+
+    #---------------------------------------------------------------------
+    # Clock-Reset connection point
+    #---------------------------------------------------------------------
+    add_interface $CLOCK_INTERFACE clock end
+    add_interface_port $CLOCK_INTERFACE clock clk Input 1
+   
+    add_interface $RESET_INTERFACE reset end
+    set_interface_property $RESET_INTERFACE associatedClock clock    
+    add_interface_port $RESET_INTERFACE reset_n reset_n Input 1
+    
+    
+    #---------------------------------------------------------------------
+    #  Avalon Agent connection point
+    #---------------------------------------------------------------------
+    add_interface $AGENT_INTERFACE avalon end
+
+    # Interface Properties
+    #---------------------------------------------------------------------
+    set_interface_property $AGENT_INTERFACE ENABLED true
+    set_interface_property $AGENT_INTERFACE ASSOCIATED_CLOCK $CLOCK_INTERFACE
+    set_interface_property $AGENT_INTERFACE addressAlignment DYNAMIC
+    set_interface_property $AGENT_INTERFACE holdTime 0
+    set_interface_property $AGENT_INTERFACE isMemoryDevice false
+    set_interface_property $AGENT_INTERFACE isNonVolatileStorage false
+    set_interface_property $AGENT_INTERFACE minimumUninterruptedRunLength 1
+    set_interface_property $AGENT_INTERFACE printableDevice false
+    set_interface_property $AGENT_INTERFACE readWaitTime $AV_READ_WAIT_TIME_VALUE
+    set_interface_property $AGENT_INTERFACE setupTime 0
+    set_interface_property $AGENT_INTERFACE timingUnits Cycles
+    set_interface_property $AGENT_INTERFACE writeWaitTime $AV_WRITE_WAIT_TIME_VALUE
+    set_interface_property $AGENT_INTERFACE addressUnits $ADDRESS_UNITS_VALUE
+    set_interface_property $AGENT_INTERFACE waitRequestAllowance $AV_WAITREQUEST_ALLOWANCE_VALUE 
+
+    if {$USE_WAIT_REQUEST_VALUE == 0} {
+        set_parameter_property $AV_READ_WAIT_TIME ENABLED true
+        set_parameter_property $AV_WRITE_WAIT_TIME ENABLED true
+    } else {
+        set_parameter_property $AV_READ_WAIT_TIME ENABLED false
+        set_parameter_property $AV_WRITE_WAIT_TIME ENABLED false
+    }
+    
+    if {$USE_WRITE_VALUE == 0} {
+        set_interface_property $AGENT_INTERFACE maximumPendingWriteTransactions 0
+        set_parameter_property $AV_MAX_PENDING_WRITES ENABLED false
+    } else {
+        set_interface_property $AGENT_INTERFACE maximumPendingWriteTransactions $AV_MAX_PENDING_WRITES_VALUE
+        set_parameter_property $AV_MAX_PENDING_WRITES ENABLED true
+    }
+    
+    if {$USE_READ_VALUE == 0} {
+        set_interface_property $AGENT_INTERFACE maximumPendingReadTransactions 0
+        set_parameter_property $AV_MAX_PENDING_READS ENABLED false
+    } else {
+        set_interface_property $AGENT_INTERFACE maximumPendingReadTransactions $AV_MAX_PENDING_READS_VALUE
+        set_parameter_property $AV_MAX_PENDING_READS ENABLED true
+    }
+    
+    if {$USE_READ_DATA_VALID_VALUE > 0} {
+        set_interface_property $AGENT_INTERFACE readLatency 0
+        set_parameter_property $AV_FIX_READ_LATENCY ENABLED false
+    } else {
+        set_interface_property $AGENT_INTERFACE readLatency $AV_FIX_READ_LATENCY_VALUE
+        set_parameter_property $AV_FIX_READ_LATENCY ENABLED true
+    }
+    
+
+   #  if { $AV_BURST_LINEWRAP_VALUE > 0 } {
+   #      set_interface_property $AGENT_INTERFACE linewrapBursts true
+   #  } else {
+   #      set_interface_property $AGENT_INTERFACE linewrapBursts false
+   #  }
+   #  if { $AV_BURST_BNDR_ONLY_VALUE > 0 } {
+   #      set_interface_property $AGENT_INTERFACE burstOnBurstBoundariesOnly true
+   #  } else {
+   #      set_interface_property $AGENT_INTERFACE burstOnBurstBoundariesOnly false
+   #  }
+
+   # if { $AV_REGISTERINCOMINGSIGNALS_VALUE == 0 } {
+   #    set_interface_property $AGENT_INTERFACE registerIncomingSignals false
+   # } else {
+   #    set_interface_property $AGENT_INTERFACE registerIncomingSignals true
+   # }
+    
+    # Interface Ports
+    #---------------------------------------------------------------------
+    add_interface_port $AGENT_INTERFACE avs_writedata writedata Input $AV_DATA_W_VALUE
+    set_port_property avs_writedata VHDL_TYPE STD_LOGIC_VECTOR
+    
+    # add_interface_port $AGENT_INTERFACE avs_begintransfer begintransfer Input 1
+    # add_interface_port $AGENT_INTERFACE avs_beginbursttransfer beginbursttransfer Input 1
+    if { $AV_FIX_READ_LATENCY_VALUE == 0 } {
+        add_interface_port $AGENT_INTERFACE avs_burstcount burstcount Input $AV_BURSTCOUNT_W_VALUE
+        set_port_property avs_burstcount VHDL_TYPE STD_LOGIC_VECTOR
+    }
+
+    add_interface_port $AGENT_INTERFACE avs_readdata readdata Output $AV_DATA_W_VALUE
+    set_port_property avs_readdata VHDL_TYPE STD_LOGIC_VECTOR
+    add_interface_port $AGENT_INTERFACE avs_address address Input $AV_ADDRESS_W_VALUE
+    set_port_property avs_address VHDL_TYPE STD_LOGIC_VECTOR
+
+    if {$USE_WAIT_REQUEST_VALUE > 0} {
+         add_interface_port $AGENT_INTERFACE avs_waitrequest waitrequest Output 1
+    }
+    
+    if {$ASSERT_HIGH_WRITE_VALUE > 0} {
+        add_interface_port $AGENT_INTERFACE avs_write write Input 1
+    } else {
+        add_interface_port $AGENT_INTERFACE avs_write write_n Input 1
+    }
+    if {$ASSERT_HIGH_READ_VALUE > 0} {
+        add_interface_port $AGENT_INTERFACE avs_read read Input 1
+    } else {
+        add_interface_port $AGENT_INTERFACE avs_read read_n Input 1
+    }
+    if {$ASSERT_HIGH_BYTEENABLE_VALUE > 0} {
+        add_interface_port $AGENT_INTERFACE avs_byteenable byteenable Input $AV_NUMSYMBOLS_VALUE
+        set_port_property avs_byteenable VHDL_TYPE STD_LOGIC_VECTOR
+    } else {
+        add_interface_port $AGENT_INTERFACE avs_byteenable byteenable_n Input $AV_NUMSYMBOLS_VALUE
+        set_port_property avs_byteenable VHDL_TYPE STD_LOGIC_VECTOR
+    }
+    if {$ASSERT_HIGH_READDATAVALID_VALUE > 0} {
+        add_interface_port $AGENT_INTERFACE avs_readdatavalid readdatavalid Output 1
+    } else {
+        add_interface_port $AGENT_INTERFACE avs_readdatavalid readdatavalid_n Output 1
+    }
+ 
+   # Terminate unused ports 
+   #---------------------------------------------------------------------    
+
+    if {$USE_WRITE_VALUE == 0} {
+        set_port_property avs_write                TERMINATION 1  
+        set_port_property avs_write                TERMINATION_VALUE 0
+    }
+    if {$USE_READ_VALUE == 0} {
+        set_port_property avs_read                 TERMINATION 1
+        set_port_property avs_read                 TERMINATION_VALUE 0
+    }
+    if {$USE_ADDRESS_VALUE == 0} {
+        set_port_property avs_address              TERMINATION 1
+        set_port_property avs_address              TERMINATION_VALUE 0
