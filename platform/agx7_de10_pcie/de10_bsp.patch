+
+proc list_plls_in_design { } {
+  post_message "Found the following IOPLLs in design:"
+  foreach_in_collection node [get_atom_nodes -type IOPLL] {
+    set name [get_atom_node_info -key NAME -node $node]
+    post_message "   $name"
+  }
+}
