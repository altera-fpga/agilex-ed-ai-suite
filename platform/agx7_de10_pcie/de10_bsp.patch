+add_parameter COMPONENT_HAS_AGENT_RETURN INTEGER 0 "If set, read the return value from the component's agent registers into the return output stream."
+set_parameter_property COMPONENT_HAS_AGENT_RETURN DEFAULT_VALUE 0
+set_parameter_property COMPONENT_HAS_AGENT_RETURN DISPLAY_NAME COMPONENT_HAS_AGENT_RETURN
+set_parameter_property COMPONENT_HAS_AGENT_RETURN TYPE INTEGER
+set_parameter_property COMPONENT_HAS_AGENT_RETURN UNITS None
+set_parameter_property COMPONENT_HAS_AGENT_RETURN DESCRIPTION "If set, read the return value from the component's agent registers into the return output stream."
+set_parameter_property COMPONENT_HAS_AGENT_RETURN HDL_PARAMETER true
+
+add_parameter COMPONENT_AGENT_WRITE_INTERFACE_NAME STRING "__ihc_hls_avs_write_stream__" "The name of the testbench stream that passes the write data to the agent in the simulation"
+set_parameter_property COMPONENT_AGENT_WRITE_INTERFACE_NAME DEFAULT_VALUE "__ihc_hls_avs_write_stream__"
+set_parameter_property COMPONENT_AGENT_WRITE_INTERFACE_NAME DISPLAY_NAME COMPONENT_AGENT_WRITE_INTERFACE_NAME
+set_parameter_property COMPONENT_AGENT_WRITE_INTERFACE_NAME TYPE STRING
+set_parameter_property COMPONENT_AGENT_WRITE_INTERFACE_NAME UNITS None
+set_parameter_property COMPONENT_AGENT_WRITE_INTERFACE_NAME DESCRIPTION "The name of the testbench stream that passes the write data to the agent in the simulation"
+set_parameter_property COMPONENT_AGENT_WRITE_INTERFACE_NAME HDL_PARAMETER true
+
+add_parameter COMPONENT_AGENT_READ_INTERFACE_NAME STRING {$return} "The name of the testbench stream that passes the read data from the agent in the simulation to the testbench"
+set_parameter_property COMPONENT_AGENT_READ_INTERFACE_NAME DEFAULT_VALUE {$return}
+set_parameter_property COMPONENT_AGENT_READ_INTERFACE_NAME DISPLAY_NAME COMPONENT_AGENT_READ_INTERFACE_NAME
+set_parameter_property COMPONENT_AGENT_READ_INTERFACE_NAME TYPE STRING
+set_parameter_property COMPONENT_AGENT_READ_INTERFACE_NAME UNITS None
+set_parameter_property COMPONENT_AGENT_READ_INTERFACE_NAME DESCRIPTION "The name of the testbench stream that passes the read data from the agent in the simulation to the testbench"
+set_parameter_property COMPONENT_AGENT_READ_INTERFACE_NAME HDL_PARAMETER true
+
+add_parameter COMPONENT_CRA_AGENT INTEGER 0 "If set, the agent write stream contains address and byteenable information. Otherwise, it is jsut a data stream."
+set_parameter_property COMPONENT_CRA_AGENT DEFAULT_VALUE 0
+set_parameter_property COMPONENT_CRA_AGENT DISPLAY_NAME COMPONENT_CRA_AGENT
+set_parameter_property COMPONENT_CRA_AGENT TYPE INTEGER
+set_parameter_property COMPONENT_CRA_AGENT UNITS None
+set_parameter_property COMPONENT_CRA_AGENT DESCRIPTION "If set, the agent write stream contains address and byteenable information. Otherwise, it is jsut a data stream."
+set_parameter_property COMPONENT_CRA_AGENT HDL_PARAMETER true
+
+add_parameter NUM_AGENT_MEMORIES INTEGER 0 "If this is the CRA agent, it needs to know how many other agents to wait for before writing to its registers so as not to write the start bit too early."
+set_parameter_property NUM_AGENT_MEMORIES DEFAULT_VALUE 0
+set_parameter_property NUM_AGENT_MEMORIES DISPLAY_NAME NUM_AGENT_MEMORIES
+set_parameter_property NUM_AGENT_MEMORIES TYPE INTEGER
+set_parameter_property NUM_AGENT_MEMORIES UNITS None
+set_parameter_property NUM_AGENT_MEMORIES DESCRIPTION "If this is the CRA agent, it needs to know how many other agents to wait for before writing to its registers so as not to write the start bit too early."
