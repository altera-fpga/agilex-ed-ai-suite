+          .resetn             (!reset),
+          .i_to_avm_port_num  (),
+          .i_to_avm_burstcount(rd_burstcount),
+          .i_to_avm_id        (rd_o_id),
+          .i_to_avm_valid     (to_avm_valid),
+          .i_data             (i_data),
+          .i_data_valid       (i_data_valid),
+          .o_id_af            (id_af[z]),
+          .o_data             (rd_data[z]),
+          .o_data_valid       (rd_data_valid[z]),
