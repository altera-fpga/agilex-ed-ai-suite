+set_parameter_property COMPONENT_NUM_OUTPUT_STREAMS DESCRIPTION "The number of stream_out interfaces on the component."
+set_parameter_property COMPONENT_NUM_OUTPUT_STREAMS HDL_PARAMETER true
+
+
