+            if (VALID_IN_EARLINESS > 0) begin
+                always @(posedge clock) begin
+                    i_valid_dups[z] <= i_valid;
+                end
+            end else begin
+                assign i_valid_dups[z] = i_valid;
+            end
+            if (STALL_IN_EARLINESS > 0) begin
+                always @(posedge clock) begin
+                    i_stall_dups[z] <= i_stall;
+                end
+            end else begin
+                assign i_stall_dups[z] = i_stall;
+            end
