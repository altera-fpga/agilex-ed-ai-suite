+                      local_id_0_pipe[PIPELINE_DEPTH], local_id_1_pipe[PIPELINE_DEPTH], local_id_2_pipe[PIPELINE_DEPTH] }),
+          .valid_out(valid_out),
+          .valid_out_lookahead(valid_out_lookahead),
+          .stall_in(stall_in),
+          .data_out({ global_id[0], global_id[1], global_id[2],
