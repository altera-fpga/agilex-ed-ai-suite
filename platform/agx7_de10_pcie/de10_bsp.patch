diff -ru --unidirectional-new-file ./hld/ip/board_iofs/opencl_sim/aoc_sim_stream_sink_dpi_bfm_hw.tcl b/hld/ip/board_iofs/opencl_sim/aoc_sim_stream_sink_dpi_bfm_hw.tcl
--- ./hld/ip/board_iofs/opencl_sim/aoc_sim_stream_sink_dpi_bfm_hw.tcl	1969-12-31 16:00:00.000000000 -0800
