+    defparam mac_fp_wys.az_clock = "0";
+    defparam mac_fp_wys.accumulate_clock = "0";
+    defparam mac_fp_wys.ax_chainin_pl_clock = "none";
+    defparam mac_fp_wys.accum_pipeline_clock = "0";
+    defparam mac_fp_wys.mult_pipeline_clock = "0";
