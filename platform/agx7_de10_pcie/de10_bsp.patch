+// DESCRIPTION
+// MLAB with 5 bit words.  1 addr lines.
+// Generated by one of Gregg's toys.   Share And Enjoy.
+
+module alt_hiconnect_mlab5a1r1w1 #(
+    parameter SIM_EMULATE = 1'b0
+) (
+    input wclk,
+    input [0:0] waddr,
+    input [4:0] din,
+    input rclk,
+    input [0:0] raddr,
+    output [4:0] dout
+);
+
+////////////////////////////
+// handle data bits 4..0
+
+reg [0:0] waddr_m0 = 1'b0 /* synthesis preserve */;
+always @(posedge wclk) waddr_m0 <= waddr;
+
+reg [4:0] wdata_m0 = 5'b0 /* synthesis preserve */;
+always @(posedge wclk) wdata_m0 <= din[4:0];
+
+reg [0:0] raddr_m0 = 1'b0 /* synthesis preserve */;
+always @(posedge rclk) raddr_m0 <= raddr;
+
+alt_hiconnect_mlab m0 (
+	.wclk(wclk),
+	.wena(1'b1),
+	.waddr_reg(waddr_m0),
+	.wdata_reg(wdata_m0),
+	.raddr(raddr_m0),
+	.rdata(dout[4:0])
+);
+defparam m0 .WIDTH = 5;
+defparam m0 .ADDR_WIDTH = 1;
+defparam m0 .SIM_EMULATE = SIM_EMULATE;
+
+endmodule
