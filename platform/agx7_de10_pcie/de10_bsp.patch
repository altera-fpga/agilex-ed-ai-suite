+    localparam MUX_SELECT_BE_COPIES = (WIDE_DATA_SLICING==0) ? 1 : (MWIDTH_BYTES*MUX_DATA_SLICING_MULTIPLIER+WIDE_DATA_SLICING-1) / WIDE_DATA_SLICING;
