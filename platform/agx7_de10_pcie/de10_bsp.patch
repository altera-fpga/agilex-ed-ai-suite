+          for(i=0; i<NUM_DIMM; i=i+1) begin : GEN_RANDOM_BLOCK_NAME_R193
+            for (int z=0;z<NUM_REORDER;z++) begin : GEN_RANDOM_BLOCK_NAME_R194
