+        .b_address              (mb_b_address),
+        .b_write                (mb_b_write),
+        .b_in_clock_en          (b_in_clock_en),
+        .b_out_clock_en         (b_out_clock_en),
+        .top_b_address          (mid_b_address),
+        .bot_b_address          (bot_b_address),
