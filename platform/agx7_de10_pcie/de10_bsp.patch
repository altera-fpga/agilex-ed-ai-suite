+    //=======================================================
+    // Constants
+    //=======================================================
+
+    //can attach up to one CoreDLA instance per DDR
+    localparam int MAX_DLA_INSTANCES = 4;
+
+    // Assuming a few hundred MHz, a free running 32-bit counter won't overflow within 1 second
+    localparam int HW_TIMER_WIDTH = 32;
+
+    //axi constants
+    localparam int AXI_BURST_LENGTH_WIDTH = 8;  //width of the axi burst length signal as per the axi4 spec
+    localparam int AXI_BURST_SIZE_WIDTH = 3;    //width of the axi burst size signal as per the axi4 spec
+    localparam int AXI_BURST_TYPE_WIDTH = 2;    //width of the axi burst type signal as per the axi4 spec
+
+    `include "dla_dma_param.svh"
+    `include "dla_acl_parameter_assert.svh"
+
+    //=======================================================
+    // Signals
+    //=======================================================
+
+    // TOOD (andrewud): add BMC module and wiring into board module
+
+    //clocks (these are user clocks, not emif clocks nor reference clocks)
+    logic                                   clk_dla;
+    logic                                   clk_dla_2x;
+    logic                                   clk_pcie;
+    logic                                   clk_ddr                 [MAX_DLA_INSTANCES];
+
+    //resets
+    logic                                   dla_sw_resetn;                  //this is a software controlled reset on clk_pcie
+    logic                                   dla_global_resetn_async;        //this drives the async reset for all things dla -- don't change this name since sdc false path is applied to it
+    logic                                   resetn_dla;
+    logic                                   resetn_pcie;
+    logic                                   resetn_ddr              [MAX_DLA_INSTANCES];
+
+    //dla level interrupts
+    logic                                   dla_interrupt_level;
+
+    //dla csr axi interfaces
+    logic        [C_CSR_AXI_ADDR_WIDTH-1:0] dla_csr_awaddr          [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_awvalid         [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_awready         [MAX_DLA_INSTANCES];
+    logic        [C_CSR_AXI_DATA_WIDTH-1:0] dla_csr_wdata           [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_wvalid          [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_wready          [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_bvalid          [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_bready          [MAX_DLA_INSTANCES];
+    logic        [C_CSR_AXI_ADDR_WIDTH-1:0] dla_csr_araddr          [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_arvalid         [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_arready         [MAX_DLA_INSTANCES];
+    logic        [C_CSR_AXI_DATA_WIDTH-1:0] dla_csr_rdata           [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_rvalid          [MAX_DLA_INSTANCES];
+    logic                                   dla_csr_rready          [MAX_DLA_INSTANCES];
+
+    //dla ddr axi interfaces
+    logic        [C_DDR_AXI_ADDR_WIDTH-1:0] dla_ddr_awaddr          [MAX_DLA_INSTANCES];
+    logic      [AXI_BURST_LENGTH_WIDTH-1:0] dla_ddr_awlen           [MAX_DLA_INSTANCES];
+    logic        [AXI_BURST_SIZE_WIDTH-1:0] dla_ddr_awsize          [MAX_DLA_INSTANCES];
+    logic        [AXI_BURST_TYPE_WIDTH-1:0] dla_ddr_awburst         [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_awvalid         [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_awready         [MAX_DLA_INSTANCES];
+    logic        [C_DDR_AXI_DATA_WIDTH-1:0] dla_ddr_wdata           [MAX_DLA_INSTANCES];
+    logic    [(C_DDR_AXI_DATA_WIDTH/8)-1:0] dla_ddr_wstrb           [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_wlast           [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_wvalid          [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_wready          [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_bvalid          [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_bready          [MAX_DLA_INSTANCES];
+    logic   [C_DDR_AXI_THREAD_ID_WIDTH-1:0] dla_ddr_arid            [MAX_DLA_INSTANCES];
+    logic        [C_DDR_AXI_ADDR_WIDTH-1:0] dla_ddr_araddr          [MAX_DLA_INSTANCES];
+    logic      [AXI_BURST_LENGTH_WIDTH-1:0] dla_ddr_arlen           [MAX_DLA_INSTANCES];
+    logic        [AXI_BURST_SIZE_WIDTH-1:0] dla_ddr_arsize          [MAX_DLA_INSTANCES];
+    logic        [AXI_BURST_TYPE_WIDTH-1:0] dla_ddr_arburst         [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_arvalid         [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_arready         [MAX_DLA_INSTANCES];
+    logic   [C_DDR_AXI_THREAD_ID_WIDTH-1:0] dla_ddr_rid             [MAX_DLA_INSTANCES];
+    logic        [C_DDR_AXI_DATA_WIDTH-1:0] dla_ddr_rdata           [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_rlast           [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_rvalid          [MAX_DLA_INSTANCES];
+    logic                                   dla_ddr_rready          [MAX_DLA_INSTANCES];
+
+    //some other stuff related to ddr
+    logic                                   ddr4_local_cal_success  [MAX_DLA_INSTANCES];
+    logic                                   ddr4_calibrate_req_n    [MAX_DLA_INSTANCES];
+
+    //hw timer avalon signals
+    logic                                   dla_hw_timer_write;
+    logic                                   dla_hw_timer_read;
+    logic             [HW_TIMER_WIDTH-1:0]  dla_hw_timer_readdata;
+    logic             [HW_TIMER_WIDTH-1:0]  dla_hw_timer_writedata;
+
+    //hw timer, for inferring CoreDLA clock frequency from host
+    logic                                   dla_hw_timer_start;
+    logic                                   dla_hw_timer_stop;
+    logic              [HW_TIMER_WIDTH-1:0] dla_hw_timer_counter;
+
+    //mapping of avalon interface to the hw timer signals
+    assign dla_hw_timer_start = dla_hw_timer_write & dla_hw_timer_writedata[0];
+    assign dla_hw_timer_stop = dla_hw_timer_write & dla_hw_timer_writedata[1];
+    assign dla_hw_timer_readdata = dla_hw_timer_counter;
+
+    //bmc wiring
+    wire [31: 0]  o_board_ver;
+    wire [31: 0]  o_maxcode_ver;
+    wire [31: 0]  o_powerin_volt;
+    wire [31: 0]  o_powerin_curr;
+    wire [31: 0]  o_core_volt1;
+    wire [31: 0]  o_core_curr1;
+    wire [31: 0]  o_core_volt2;
+    wire [31: 0]  o_core_curr2;
+    wire [31: 0]  o_fan_speed1;
+    wire [31: 0]  o_fan_speed2;
+    wire [31: 0]  o_temp_fpga;
+    wire [31: 0]  o_temp_board1;
+    wire [31: 0]  o_temp_board2;
+    wire [31: 0]  o_temp_sdm;
+    wire [31: 0]  o_temp_etile;
+    wire [31: 0]  o_temp_ptile;
+
+    //=======================================================
+    // Enable SI5397A to output 50MHz for config_clk
+    //=======================================================
+    assign SI5397A_OE_n = 1'b0;
+    assign SI5397A_RST_n = 1'b1;
+
+    //=======================================================
+    // LEDs for debug
+    //=======================================================
+    assign led[0]=~ddr4_local_cal_success[0];
+    assign led[1]=~ddr4_local_cal_success[1];
+    assign led[2]=~ddr4_local_cal_success[2];
+    assign led[3]=~ddr4_local_cal_success[3];
+
+    //=======================================================
+    // board info module (bmc)
+    //=======================================================
+    BOARD_INFO BOARD_INFO_i
+    (
+        .RESET_N          (1'b1),
+        .CLK_50           (config_clk),
+
+        // 4-pin SPI master interface
+        .SCLK             (INFO_SPI_SCLK),
+        .MISO             (INFO_SPI_MISO),
+        .MOSI             (INFO_SPI_MOSI),
+        .CS_n             (INFO_SPI_CS_n),
+
+        // status report (output)
+        .Board_Version    (o_board_ver), 		//A~F.ex BOARD_VERSION = 16'h000b ,express to revB
+        .MaxCode_Version  (o_maxcode_ver), 		//0~F.ex MAX10_VERSION = 16'h0004 ,express to rev4
+        .PowerIn_Voltage  (o_powerin_volt), 	//unit : Celsius degree
+        .PowerIn_Current  (o_powerin_curr), 	//unit : Celsius degree
+        .CORE_Voltage     (o_core_volt1), 		//unit : mv
+        .CORE_Current     (o_core_curr1), 		//unit : mA
+        .Fan_Speed        (o_fan_speed1), 		//unit : rpm
+        .Fan_Speed2       (o_fan_speed2), 		//unit : rpm
+        .Temp_FPGA        (o_temp_fpga), 		//unit : Celsius degree
+        .Temp_Board       (o_temp_board1), 		//unit : Celsius degree
