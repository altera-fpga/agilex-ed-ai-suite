+                .address2_a (1'b1),
+                .address2_b (1'b1),
+                .addressstall_a (1'b0),
+                .byteena_a (1'b1),
+                .byteena_b (1'b1),
+                .clocken0 (1'b1),
+                .clocken2 (1'b1),
+                .clocken3 (1'b1),
+                .data_b ({WIDTH{1'b1}}),
+                .eccencbypass (1'b0),
+                .eccencparity (8'b0),
+                .eccstatus (),
+                .q_a (),
+                .rden_a (1'b1),
+                .rden_b (1'b1),
+                .sclr (1'b0),
+                .wren_b (1'b0)
