+    assign lsu_rd_back_i_to_avm_id[0]         = rd_o_id;
+    assign lsu_rd_back_i_to_avm_valid[0]      = rd_request;
+
+      lsu_rd_back_n #(
+        .NUM_DIMM (NUM_DIMM),
+        .NUM_RD_PORT (NUM_RD_PORT),
+        .NUM_REORDER(NUM_REORDER_THIS_MEM_SYSTEM),
+        .BURST_CNT_W (BURST_CNT_W),
