+    logic host_root_fifo_rdreq[NUM_DIMM];
+    logic host_root_fifo_empty[NUM_DIMM];
+    logic host_root_fifo_almost_full[NUM_DIMM];
+    logic host_root_fifo_in_write[NUM_DIMM];
+    logic host_root_fifo_in_read[NUM_DIMM];
