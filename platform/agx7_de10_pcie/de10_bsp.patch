+      logic [NUM_DIMM-1:0] ecc_err_status_for_1;
+      assign ecc_err_status_lsu_rd_back[0] = |ecc_err_status_for_0;
+      assign ecc_err_status_lsu_rd_back[1] = |ecc_err_status_for_1;
+      for(z=0; z<NUM_DIMM; z=z+1) begin : GEN_DATA_VALID
