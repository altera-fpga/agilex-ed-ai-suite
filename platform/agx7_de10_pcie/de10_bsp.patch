+                .intended_device_family ("Stratix 10"), //quartus will correct this automatically to whatever your project actually uses
+                .lpm_type ("altera_syncram"),
+                .operation_mode ("DUAL_PORT"),
+                .outdata_aclr_b ("NONE"),
