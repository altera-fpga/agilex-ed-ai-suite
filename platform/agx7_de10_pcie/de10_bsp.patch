+            clk   : in  std_logic;
+            aclr  : in  std_logic;
+            ena   : in  std_logic := '1';
+            xin0  : in  std_logic_vector(width-1 downto 0);
+			xin1  : in  std_logic_vector(width-1 downto 0);
