+        .AVM_READ_DATA_LATENESS(AVM_READ_DATA_LATENESS),
+        .WIDE_DATA_SLICING(WIDE_DATA_SLICING),
+        .ALLOW_HIGH_SPEED_FIFO_USAGE(ALLOW_HIGH_SPEED_FIFO_USAGE),
