+    //                              //
+    //  Write-side width-stitching  //
+    //                              //
+    //////////////////////////////////
+
+    //make NUM_HOSTS bundles of [write, read, address, burstcount, byteenable, writedata] at the width of the host interface
+    //common signals [write, read, burstcount] should be replicated per host interface for physical routability
+    //data signals [writedata, byteenable] are width-sliced -- host interface i should grab bits [i*SIZE +: SIZE] from the agent interface
+    //address is a bit of a special case - the bottom $clog2(NUM_HOSTS) bits need to be removed from the agent address to get the host address
+    always_comb begin
+        for (int unsigned i=0; i<NUM_HOSTS; i++) begin
