+++ b/hld/ip/acl_embedded_workgroup_issuer_fifo.v	2024-10-21 09:40:24.591702000 -0700
@@ -0,0 +1,155 @@
+//// (c) 1992-2021 Intel Corporation.                            
+// Intel, the Intel logo, Intel, MegaCore, NIOS II, Quartus and TalkBack words    
