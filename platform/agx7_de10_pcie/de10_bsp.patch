+             start_hold_count <= START_HOLD_NUM_CYCLES;
+             start_received <= 1'b0;
+          end else begin
+             if (start) begin
+                start_received <= 1'b1;                // assert start_received when start is asserted
+                start_hold <= 1'b1;
+                start_hold_count <= START_HOLD_NUM_CYCLES;
