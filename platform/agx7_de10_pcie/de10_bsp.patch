+            #(
+                .WIDTH                      (SLICE_WIDTH_LOCAL),
+                .DEPTH                      (DEPTH),
+
+                //occupancy
+                .ALMOST_EMPTY_CUTOFF        (ALMOST_EMPTY_CUTOFF),
+                .ALMOST_FULL_CUTOFF         (ALMOST_FULL_CUTOFF),
+                .INITIAL_OCCUPANCY          (INITIAL_OCCUPANCY),
+
+                //reset configuration
