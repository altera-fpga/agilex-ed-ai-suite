# Toplevel and toplevel RTL
set_global_assignment -name TOP_LEVEL_ENTITY top

# Quartus version assignments
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 22.4.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "13:59:28  MAY 15, 2023"
set_global_assignment -name LAST_QUARTUS_VERSION "26.3.0 Pro Edition"

# Device properties
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGIB027R31B1E1VB

# Flow assignments
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name DESIGN_ASSISTANT_WAIVER_FILE etile_10gbe_da_drc.dawf

# Configuration Assignments
set_global_assignment -name HPS_DAP_NO_CERTIFICATE on
set_global_assignment -name ENABLE_INTERMEDIATE_SNAPSHOTS ON
set_global_assignment -name USE_HPS_COLD_RESET SDM_IO11
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name HPS_INITIALIZATION "AFTER INIT_DONE"
set_global_assignment -name HPS_DAP_SPLIT_MODE "SDM PINS"
set_global_assignment -name INI_VARS "ASM_ENABLE_ADVANCED_DEVICES=ON; hps_dump_handoff_data=on"
set_global_assignment -name VID_OPERATION_MODE "PMBUS MASTER"
set_global_assignment -name USE_PWRMGT_SCL SDM_IO0
set_global_assignment -name USE_PWRMGT_SDA SDM_IO12
set_global_assignment -name PWRMGT_BUS_SPEED_MODE "100 KHZ"
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE LTC3888
set_global_assignment -name NUMBER_OF_SLAVE_DEVICE 1
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 62
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT VOLTS
set_global_assignment -name STRATIX_JTAG_USER_CODE 4
set_global_assignment -name USE_CHECKSUM_AS_USERCODE OFF

################################################################################
#
# SoC Pinout
#
################################################################################
source pins.tcl

################################################################################
#
# Include all the IP files for the Qsys block
#
################################################################################
set_global_assignment -name IP_SEARCH_PATHS "../../coredla_ip/**/*; ./non_acds_ip/**/*; ../coredla_ip/**/*"

# Define the board
set_global_assignment -name BOARD "Agilex 7 FPGA I-Series Transceiver-SoC Development Kit 4xF-Tile DK-SI-AGI027FC"
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100

set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name VERILOG_FILE debounce.v

# SDC files
set_global_assignment -name SDC_FILE top.sdc

# IP_SEARCH_PATHS covers the custom IP _hw.tcl files, which the VDS build needs
# before any generated assignments exist; the DLA IP is picked up from
# altera.ipx in this directory.
set_global_assignment -name IP_SEARCH_PATHS "ip/**/*"

# VDS systems and their generated IP. build_project.sh sources system.tcl to
# build the VDS systems under src/vds and writes their VDS_FILE/VDS_IP_FILE
# assignments into this generated file.
source vds_files.tcl

set_global_assignment -name SEED 1
